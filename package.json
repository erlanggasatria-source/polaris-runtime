{
  "name": "@polaris-runtime/core",
  "version": "2.0.1",
  "description": "Polaris Runtime - self describing runtime",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dev": {
      "import": "./dist/dev.js",
      "require": "./dist/dev.js",
      "types": "./dist/dev.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "workflow",
    "runtime",
    "typescript",
    "polaris",
    "self-describing",
    "workflow-engine"
  ],
  "author": "Polaris Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erlanggasatria-source/polaris-runtime.git"
  },
  "homepage": "https://github.com/erlanggasatria-source/polaris-runtime#readme",
  "bugs": {
    "url": "https://github.com/erlanggasatria-source/polaris-runtime/issues"
  }
}
